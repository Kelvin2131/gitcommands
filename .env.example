# Copy this file to .env and fill in real values. Never commit .env.

# Neon pooled connection (the app uses this on every page).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# Neon direct connection (migrations only). On a laptop these two can be the same.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/neondb?sslmode=require

# Long random string. Signs session cookies. At least 16 characters.
AUTH_SECRET=replace-with-a-long-random-string

# Long random string. Vercel sends this when it runs the photo check.
CRON_SECRET=replace-with-another-long-random-string

# Warehouse clock for "today" and invoices. A US packing desk can leave this.
APP_TIMEZONE=America/New_York

# Used only by `npm run seed` and `npm run password`. Leave blank to skip.
SEED_OWNER_EMAIL=owner@kamo.example
SEED_OWNER_PASSWORD=
SEED_STAFF_EMAIL=staff@kamo.example
SEED_STAFF_PASSWORD=

# Optional. Set to 0 only when trying `npm start` on plain http.
# COOKIE_SECURE=0
